# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local generated datasets & scraper caches (prevent Vercel unpack error from long filenames)
/src/xdata/prepared_tests
/src/xdata/topics
/src/xdata/.cache*
/src/xdata/rajasthan_selected_topics_question_15000.json
*.zip

# python
__pycache__/
*.py[cod]
*$py.class

# local database backups
convex-latest-backup/

# intermediate question extraction and audit batches (safeguards Vercel < 25MB quota)
/data/questions/gemini_audited_batches/
/data/questions/gemini_batches/
/data/questions/extracted_by_topic/
/data/questions/extracted_non_mcqs_master.json
/data/questions/rajasthan-gk-backup-full/
/data/questions/pipeline_progress.json

# temporary audit scratch scripts
/scripts/test_*.js
/scripts/check_*.js
/scripts/inspect_*.js
/scripts/auto_audit_pipeline.js
/scripts/heal_*.js
/scripts/apply_convex_healings.js
/scripts/merge_*.js
/scripts/verify_*.js




